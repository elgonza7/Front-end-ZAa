VITE_API_BASE_URL=http://localhost:5432/api

# App ID de la App central de Meta (no es secreto, se expone al SDK de
# Facebook en el navegador) y el Configuration ID de "WhatsApp Embedded
# Signup" que armás en developers.facebook.com → tu App → Facebook Login
# for Business → Configuraciones. Si se dejan vacíos, el botón "Conectar
# con Facebook" de WhatsAppConnect no se muestra (se cae al formulario
# manual existente).
VITE_META_APP_ID=
VITE_META_WHATSAPP_CONFIG_ID=